CTEC_ENVIRONMENT=development
CTEC_LOG_LEVEL=INFO
CTEC_CORS_ORIGINS=["http://localhost:3000"]
CTEC_DATABASE_URL=postgresql+psycopg://ctec:ctec@postgres:5432/ctec
CTEC_DATABASE_POOL_SIZE=5
CTEC_DATABASE_MAX_OVERFLOW=10
CTEC_DATABASE_POOL_TIMEOUT_SECONDS=30
CTEC_RESOLUTION_POLICY_VERSION=ERM-001-v2.1-default
CTEC_RESOLUTION_RESOLVED_THRESHOLD=0.90
CTEC_RESOLUTION_POSSIBLE_THRESHOLD=0.65
CTEC_RESOLUTION_HIGH_CONFIDENCE_THRESHOLD=0.90
CTEC_RESOLUTION_MEDIUM_CONFIDENCE_THRESHOLD=0.65
CTEC_SEMANTIC_POLICY_VERSION=SRM-001-v2.1-default
CTEC_SEMANTIC_RESOLVED_THRESHOLD=0.90
CTEC_SEMANTIC_POSSIBLE_THRESHOLD=0.65
CTEC_SEMANTIC_HIGH_CONFIDENCE_THRESHOLD=0.90
CTEC_SEMANTIC_MEDIUM_CONFIDENCE_THRESHOLD=0.65
CTEC_ASSERTION_POLICY_VERSION=ASM-001-v2.0-default
CTEC_ASSERTION_ESTABLISHED_THRESHOLD=0.90
CTEC_ASSERTION_CANDIDATE_THRESHOLD=0.65
CTEC_ASSERTION_HIGH_CONFIDENCE_THRESHOLD=0.90
CTEC_ASSERTION_MEDIUM_CONFIDENCE_THRESHOLD=0.65
CTEC_GOVERNANCE_POLICY_REFERENCE=GOV-POL-DEFAULT
CTEC_GOVERNANCE_POLICY_VERSION=1.0
CTEC_GOVERNANCE_AUTHORIZED_EXCEPTION_AUTHORITIES=[]
CTEC_GOVERNANCE_HIGH_CONFIDENCE_THRESHOLD=0.90
CTEC_GOVERNANCE_MEDIUM_CONFIDENCE_THRESHOLD=0.65
CTEC_OIDC_ISSUER=https://identity.example.com/
CTEC_OIDC_AUDIENCE=ctec-supplier-risk-api
CTEC_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
CTEC_OIDC_ALGORITHMS=["RS256"]
CTEC_OIDC_SUBJECT_CLAIM=sub
CTEC_OIDC_TENANT_CLAIM=tenant_id
CTEC_OIDC_SCOPE_CLAIM=scope
CTEC_OIDC_ROLES_CLAIM=roles
CTEC_OIDC_CLOCK_SKEW_SECONDS=60
CTEC_OIDC_JWKS_CACHE_SECONDS=300
CTEC_SUPPLIER_RISK_PAYLOAD_LIMIT_BYTES=262144
CTEC_SUPPLIER_RISK_RATE_LIMIT_PER_MINUTE=60
# Secret deployment value: URL-safe base64 encoding of 16, 24, or 32 random bytes.
CTEC_RUNTIME_HANDOFF_KEY=
CTEC_RUNTIME_HANDOFF_KEY_ID=primary
NEXT_PUBLIC_CTEC_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_OIDC_AUTHORITY=https://identity.example.com/
NEXT_PUBLIC_OIDC_CLIENT_ID=ctec-frontend
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
NEXT_PUBLIC_OIDC_SCOPE=openid profile supplier-risk:read
POSTGRES_DB=ctec
POSTGRES_USER=ctec
POSTGRES_PASSWORD=ctec
